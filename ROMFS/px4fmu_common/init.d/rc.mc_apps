#!/bin/sh
#
# Standard apps for multirotors. Attitude/Position estimator, Attitude/Position control.
#
# NOTE: Script variables are declared/initialized/unset in the rcS script.
#

#
# stop Control Allocator
#
control_allocator stop

#
# stop Multicopter Rate Controller.
#
mc_rate_control stop

#
# stop Multicopter Attitude Controller.
#
mc_att_control stop

if param greater -s MC_AT_EN 0
then
	mc_autotune_attitude_control stop
fi

#
# stop Multicopter Position Controller.
#
mc_hover_thrust_estimator stop
flight_mode_manager stop
mc_pos_control stop

#
# stop Multicopter Land Detector.
#
land_detector stop multicopter
